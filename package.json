{
  "name": "@kutsan/prettier-config",
  "version": "1.3.0",
  "description": "Prettier configuration for my projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kutsan/prettier-config.git"
  },
  "license": "MIT",
  "author": "Kutsan Kaplan <me@kutsan.dev> (https://kutsan.dev)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "check": "pnpm run check:lint && pnpm run check:types && pnpm run check:format",
    "check:format": "prettier --check .",
    "check:lint": "eslint --max-warnings=0",
    "check:types": "tsc",
    "format": "prettier --write --list-different .",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "prettier-plugin-packagejson": "^3.0.2"
  },
  "devDependencies": {
    "@kutsan/eslint-config": "^2.0.5",
    "@kutsan/typescript-config": "^2.2.0",
    "@types/node": "^25.9.1",
    "eslint": "^9",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "prettier": ">=3"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.4.0",
      "onFail": "warn"
    }
  }
}
