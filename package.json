{
  "name": "@kutsan/prettier-config",
  "version": "1.2.0",
  "description": "Prettier configuration for my projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kutsan/prettier-config.git"
  },
  "license": "MIT",
  "author": "Kutsan Kaplan <me@kutsan.dev> (https://kutsan.dev)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "check": "pnpm run check:lint && pnpm run check:types && pnpm run check:format",
    "check:format": "prettier --check .",
    "check:lint": "eslint --max-warnings=0",
    "check:types": "tsc",
    "format": "prettier --write --list-different .",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "prettier-plugin-packagejson": "^3.0.2"
  },
  "devDependencies": {
    "@kutsan/eslint-config": "^1.5.0",
    "@kutsan/typescript-config": "^2.1.0",
    "@types/node": "^25.6.0",
    "eslint": "^9",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "prettier": ">=3"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn"
    }
  }
}
